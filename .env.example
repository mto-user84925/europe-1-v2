# ============================================================
#  VARIABLES D'ENVIRONNEMENT — Météo-Climat Pro
# ============================================================
#  Copier en `.env.local` pour le développement local :
#     Copy-Item .env.example .env.local
#  Puis remplir les valeurs.
#
#  ⚠️ CE FICHIER NE DOIT JAMAIS CONTENIR DE VRAIE VALEUR.
#     `.env*` et `.env*.local` sont déjà dans .gitignore.
#
#  Les variables préfixées VITE_ sont exposées au navigateur (PUBLIQUES).
#  Ne jamais y placer un secret : elles finissent dans le bundle JS.
# ============================================================


# ------------------------------------------------------------
# 1. SUPABASE — navigateur (public, sans risque)
# ------------------------------------------------------------
# Dashboard Supabase → Settings → API
# La clé "anon" / "publishable" est conçue pour être publique.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# 2. SUPABASE — serveur (SECRET, jamais VITE_)
# ------------------------------------------------------------
# Dashboard Supabase → Settings → API → service_role
# Ignore toutes les politiques RLS. Accès total en lecture/écriture.
# Usage : fonctions serverless uniquement (api/cron/*).
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# 3. MÉTÉO-FRANCE — serveur (SECRET, jamais VITE_)
# ------------------------------------------------------------
# portail-api.meteofrance.fr → Mes applications → clé
# Utilisée par api/mf-token.js pour obtenir un token OAuth.
MF_CONSUMER_KEY=
MF_CONSUMER_SECRET=

# Clé dédiée au radar (peut être la même que ci-dessus)
MF_RADAR_API_KEY=

# ------------------------------------------------------------
# 4. AGATE / foudre — serveur (SECRET)
# ------------------------------------------------------------
# Mot de passe du flux d'archives orages (api/cron/archive-foudre.js)
AGATE_PASS=

# ------------------------------------------------------------
# 5. CRONS — serveur (SECRET)
# ------------------------------------------------------------
# Authentifie les 5 endpoints api/cron/*.
# Générer une valeur aléatoire, par exemple :
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️ SANS CETTE VARIABLE, TOUS LES CRONS RENVOIENT 401 (échec fermé).
CRON_SECRET=

# ------------------------------------------------------------
# 6. E-MAIL — serveur (SECRET)
# ------------------------------------------------------------
# resend.com → API Keys
RESEND_API_KEY=
# Secret partagé vérifiant l'appel à api/send-alert.js
ALERT_SECRET=

# ------------------------------------------------------------
# 7. CARTOGRAPHIE — navigateur (public)
# ------------------------------------------------------------
# Clé de tuiles CARTO (visible dans le bundle : restreindre par Referer)
VITE_CARTO_KEY=
