{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self)" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api-agate/(.*)",
      "destination": "https://www.mwattest.fr/$1"
    },
    {
      "source": "/ORAGE/(.*)",
      "destination": "https://www.mwattest.fr/ORAGE/$1"
    },
    {
      "source": "/api-meteociel/(.*)",
      "destination": "/api/meteociel-proxy?path=$1"
    },
    {
      "source": "/api-meteo/(.*)",
      "destination": "https://public-api.meteofrance.fr/public/DPObs/v1/$1"
    },
    {
      "source": "/api-meteo-paquet/(.*)",
      "destination": "https://public-api.meteofrance.fr/public/DPPaquetObs/v1/$1"
    },
    {
      "source": "/api-meteo-poste/(.*)",
      "destination": "https://public-api.meteofrance.fr/public/DPAI01/v1/$1"
    },
    {
      "source": "/api-radar-mf/(.*)",
      "destination": "https://public-api.meteofrance.fr/public/DPPaquetRadar/v1/$1"
    },
    {
      "source": "/api-meteo-clim/(.*)",
      "destination": "https://public-api.meteofrance.fr/public/DPClim/v1/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
