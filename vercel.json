{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/rss/bigcompany.php", "destination": "/api/bigcompany" },
    { "source": "/api/rss_lyon.xml", "destination": "/api/bigcompany" },
    { "source": "/rss/bigcompany", "destination": "/api/bigcompany" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}